# "development" or "production". Production refuses to start with placeholder secrets
# and ignores ENABLE_DEV_LOGIN.
ENVIRONMENT=development

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=campusconnect

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend origin(s). Comma-separated allowed; the first is used for login redirects.
FRONTEND_URL=http://localhost:3000

# The Google account with this email becomes ADMIN at login.
ADMIN_EMAIL=admin@example.com

# Development only: enables POST /api/auth/dev-login so the app can be used
# without Google credentials. Leave false anywhere real users sign in.
ENABLE_DEV_LOGIN=false
